# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables — NEVER commit real .env files
.env
.env.local
.env.*.local
.env.production
.env.staging

# Backend secrets — same rules
backend/.env
backend/.env.local
backend/.env.*

# Supabase CLI temporary / auto-generated files (may contain DB credentials)
supabase/.temp/

# Vite dev-server timestamp cache files
vite.config.ts.timestamp-*.mjs

# Claude AI assistant local settings
.claude/

# Question JSON fix backups / local audit artifacts
*.bak
*.backup.json
*.pending-fix.bak
*.pending-fix.diff
*.audit-full.json
*.audit-full.md
*.audit-real.json
*.audit-final.json
*.fix-report.json
*.manual-spelling.json
*-sync.report.json
variants-sync-*.report.json
scripts/question-tools/ru_all_audit.json
scripts/question-tools/_patch-paths.cjs

# Local-only SEO/content tooling dumps (not needed for deploy)
# Keep: generate-*.cjs/js, build-belgilar-i18n.cjs, question-tools/, package.json scripts
scripts/_img-check/
scripts/_*
scripts/ru-batches/
scripts/*-REPORT.md
scripts/*-report.json
scripts/LETTER-MISMATCH*
scripts/VARIANTS-MANUAL*
scripts/FIX-REPORT*
scripts/SYNC-MATCHED-FROM-REPORT.md
scripts/*-cache.json

# Redundant / platform-specific files
bun.lock
netlify.toml
live_test.sh
test_migrations.sql
test_review_ratelimit.js

# Supabase migratsiyalari MCP orqali to'g'ridan-to'g'ri bazaga qo'llanadi va
# to'liq SQL matni bilan birga `supabase_migrations.schema_migrations`
# jadvalida saqlanadi — ya'ni haqiqiy manba BAZA.
# Lokal nusxalar to'liq emas (bazada 89 ta, bu yerda 17 ta) va chalg'itadi,
# shuning uchun yangilari repozitoriyga qo'shilmasin.
supabase/migrations/*.sql

# tsc -b (typecheck) yaratadigan inkremental kesh fayllari
*.tsbuildinfo

# wrangler pages dev lokal keshi
.wrangler/

# ---------------------------------------------------------------------------
# Markdown eslatmalar, tahlillar va audit hisobotlari — bular lokal ish
# qog'ozlari, GitHub ga chiqmasin.
#
# DIQQAT: .gitignore ALLAQACHON kuzatilayotgan fayllarga ta'sir qilmaydi.
# README.md va docs/ hozir ham repo da qoladi va oldingidek tahrirlanadi.
# Quyidagi `!` istisnolari niyatni aniq qilish uchun: yangi klondan keyin
# `git add -A` qilinganda ham muhim hujjatlar joyida qoladi.
# ---------------------------------------------------------------------------
*.md
!README.md
!QUICK_START.md
!LOYIHA-TAHLILI.md
!STARTUP-GOYALAR.md
!docs/*.md
!scripts/VARIANT-QUALITY-AUDIT.md

# Imlo auditi hisobotlari — lokal ish qog'ozlari, repozitoriyga kerak emas.
# (TUZATILGAN-SOZLAR.md yuqoridagi `*.md` qoidasi bilan ham qamraladi,
#  lekin niyat aniq bo'lishi uchun alohida yozilgan.)
TUZATILGAN-SOZLAR.md
SAYT-AUDIT-*.md
