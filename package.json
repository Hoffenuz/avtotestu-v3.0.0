  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts",
    "test:ui": "vitest --ui --config vitest.config.ts",
    "seo:savol": "node scripts/generate-savol-pages.cjs",
    "prebuild": "node scripts/generate-free-ids.cjs && node scripts/generate-image-sizes.cjs && node scripts/generate-qiyin-savollar.cjs && node scripts/generate-savol-pages.cjs && node scripts/generate-main-pages.cjs && node scripts/generate-seo-meta.cjs && node scripts/assert-no-spa-shadow.cjs",
    "images:sizes": "node scripts/generate-image-sizes.cjs",
