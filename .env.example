# ====================================================================
# FRONTEND ENVIRONMENT — safe to commit
# Copy to .env and fill in real values
# ====================================================================
# These are PUBLIC anon/publishable keys — they go to the browser.
# NEVER put service_role key here. NEVER put SUPABASE_SERVICE_ROLE_KEY here.
# ====================================================================

VITE_SUPABASE_PROJECT_ID="your_project_id_here"
VITE_SUPABASE_PUBLISHABLE_KEY="your_anon_key_here"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"

# Backend API URL (your Node.js backend)
VITE_BACKEND_URL="https://your-backend-url.com"
