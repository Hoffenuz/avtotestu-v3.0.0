# Vite — barcha frontend o'zgaruvchilar VITE_ bilan boshlanishi kerak.
# Nusxa: cp .env.example .env.local  (yoki .env.local yarating)

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Ixtiyoriy — CLI / export skriptlari uchun
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Payme kassa (merchant) ID — Payme kabinetidagi 24 belgili identifikator.
# MAXFIY EMAS: to'lov havolasi ichida ochiq ko'rinadi.
# Maxfiy kassa KALITI bu yerga YOZILMAYDI — u Supabase Vault da
# (`payme_merchant_key`) saqlanadi va faqat server tomonda ishlatiladi.
# Bo'sh qoldirilsa, Pro sahifasidagi tugmalar eski holicha (Telegram) ishlaydi.
VITE_PAYME_MERCHANT_ID=

# CLICK kassa identifikatorlari (kabinet: merchant.click.uz). MAXFIY EMAS —
# to'lov havolasida ochiq ko'rinadi. Maxfiy SECRET_KEY bu yerga YOZILMAYDI:
# u Supabase Vault da (`click_secret_key`) saqlanadi.
# SERVICE_ID yoki MERCHANT_ID bo'sh bo'lsa, Pro sahifasida Click tanlovi
# ko'rsatilmaydi (faqat Payme qoladi).
VITE_CLICK_SERVICE_ID=
VITE_CLICK_MERCHANT_ID=
VITE_CLICK_MERCHANT_USER_ID=

# Cloudflare Turnstile site key — ro'yxatdan o'tish formasi uchun.
# MAXFIY EMAS (sahifada ochiq). Maxfiy kalit faqat Supabase Vault da.
VITE_TURNSTILE_SITE_KEY=

# Telegram Login Widget uchun bot foydalanuvchi nomi ("@" belgisisiz).
# MAXFIY EMAS. Bu bot @BotFather'da /setdomain orqali saytga bog'langan
# bo'lishi SHART, aks holda vidjet ishlamaydi. Bo'sh qoldirilsa — Telegram
# orqali kirish tugmasi UMUMAN ko'rsatilmaydi.
# Bot tokenining o'zi Supabase Vault'da (TELEGRAM_LOGIN_BOT_TOKEN).
VITE_TELEGRAM_LOGIN_BOT=
