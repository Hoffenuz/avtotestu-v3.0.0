        "content": {
            "uz_lat": {
                "text": "Jarohatdan behushlanganda birinchi tibbiy yordamni qanday ko'rsatish kerak?",
                "options": [
                    {
                        "id": 1,
                        "text": "Mutloq tinch qo'yish. Boshni tushirish, oyoqlarni ko'tarish, badanni isitish. Qaynoq ichimlik (choy va shu kabilar) berish. Bog'langan jgutni shifokorsiz echmaslik va bo'shatmaslik",
                        "is_correct": true
                    },
                    {
                        "id": 2,
                        "text": "Kiyim-boshni yechish yoki bo'shatish, toza havo kelishini ta'minlash. Nashatir spirti hidlatish. Yuzga sovuq suv sepish. Peshonaga va gardanga iliq malhamlar qo'yish",
                        "is_correct": false
                    }
                ]
            },
            "uz_cyr": {
                "text": "Жароҳатдан беҳушланганда биринчи тиббий ёрдамни қандай кўрсатиш керак?",
                "options": [
                    {
                        "id": 1,
                        "text": "Мутлоқ тинч қўйиш. Бошни тушириш, оёқларни кўтариш, баданни иситиш. Қайноқ ичимлик (чой ва шу кабилар) бериш. Боғланган жгутни шифокорсиз ечмаслик ва бўшатмаслик",
                        "is_correct": true
                    },
                    {
                        "id": 2,
                        "text": "Кийим-бошни ечиш ёки бўшатиш, тоза ҳаво келишини таъминлаш. Нашатир спирти ҳидлатиш. Юзга совуқ сув сепиш. Пешонага ва гарданга илиқ малҳамлар қўйиш",
                        "is_correct": false
                    }
                ]
            },
            "ru": {
                "text": "Как оказать первую медицинскую помощь при травматическом шоке?",
                "options": [
                    {
                        "id": 1,
                        "text": "Одежду снять или ослабить. Обеспечить приток свежего воздуха. Дать понюхать нашатырный спирт. Обрызгать лицо холодной водой. На лоб и затылок наложить теплые примочки",
                        "is_correct": true
                    },
                    {
                        "id": 2,
                        "text": "Полный покой. Голову опустить, ноги приподнять, тело согреть. Дать выпить горячее питье (чай и т.д.). Наложенный жгут без врача не снимать и не ослаблять",
                        "is_correct": false
                    }
                ]
            }
        }
