/*
  # FAQAT xavfsizlik headerlari.
  # Cache-Control bu yerda BO'LMASIN — /* no-store /_seo va JSON s-maxage ni
  # "no-store, public, ..." qilib aralashtirib CF Bypass qilardi.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  # cloudflareinsights.com — Cloudflare Web Analytics beaconini Pages o'zi
  # HTML ga qo'shadi. CSP da ruxsat bo'lmagani uchun u bloklanardi: analitika
  # yoqilgan, lekin bironta ham tashrif yozilmasdi.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' https://pub-ad116decdc154b0f90a4b452c72fa433.r2.dev blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://www.googletagmanager.com https://pub-ad116decdc154b0f90a4b452c72fa433.r2.dev https://challenges.cloudflare.com https://cloudflareinsights.com https://static.cloudflareinsights.com; font-src 'self'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'

# SPA shell — HECH QACHON eskisi ishlatilmasin, LEKIN no-store emas.
#
#   no-store  = umuman saqlanmaydi → har kirishda to'liq ~11 KB HTML qayta
#               yuklanadi (sekin tarmoqda seziladigan lag).
#   no-cache  = saqlanadi, AMMO har safar validatsiya qilinadi → o'zgarmagan
#               bo'lsa 304 Not Modified (~200 bayt). Yangilik chiqsa darhol
#               yangi HTML keladi — ya'ni eskirish xavfi bir xil darajada yo'q.
#
# Bosh sahifa butun trafikning ~96% ini oladi, shuning uchun bu eng katta
# tezlik yutug'i. `/` middleware da next() bilan tegilmay o'tadi, demak
# Cloudflare Pages ning ETag i saqlanadi va 304 haqiqatan ishlaydi.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# ---------------------------------------------------------------------------
# SEO snapshot (botlar) — Cloudflare edge kesh MUHIM.
# Googlebot 100k+ so'rov yuborganda origin emas, edge dan olinadi.
# s-maxage = CDN kesh; max-age = brauzer (qisqa).
# ---------------------------------------------------------------------------
/_seo/*
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

# ---------------------------------------------------------------------------
# JSON test ma'lumotlari — brauzer 1 soat + edge 24 soat
# MUHIM: s-maxage bo'lmasa CF "Bypass" ko'rsatadi (faqat max-age yetarli emas).
#
# 600.json / barcha.json bu yerda YO'Q: ular QA tooling uchun manba ma'lumot,
# deploy ga chiqmaydi (vite.config.ts → excludeSourceDataFromDist).
# 700baza.json / 700baza2.json / malumotlar.json — mavjud emas, olib tashlandi.
#
# free-*.json  — bepul (1000 ta savol)
# barcha-*.json — PRO (1250 ta savol)
#
# DIQQAT: bu fayllar uzoq keshlanadi. Kontent o'zgarganda
# src/lib/fetchQuestionJson.ts dagi QUESTION_DATA_CACHE_BUST ni yangilang,
# aks holda foydalanuvchilar eski nusxani ko'rishda davom etadi.
# ---------------------------------------------------------------------------
/free-uz-lat.json
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

/free-uz-cyr.json
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

