/*
  # HTML sahifalari uchun kesh yo'q — middleware bot vs user routing qiladi.
  # HTML ni brauzer ham, CF edge ham keshlamasligi kerak.
  # (Assetlar quyidagi aniqroq qoidalar bilan kesha olinadi.)
  Cache-Control: no-store

  # HSTS — 1 yil HTTPS majburiyati; subdomenlar + preload
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # MIME-type sniffing himoyasi
  X-Content-Type-Options: nosniff

  # Clickjacking blok
  X-Frame-Options: DENY

  # Referrer cheklovi
  Referrer-Policy: strict-origin-when-cross-origin

  # Brauzer imkoniyatlarini cheklash
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # Content Security Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' https://pub-ad116decdc154b0f90a4b452c72fa433.r2.dev blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://www.googletagmanager.com https://pub-ad116decdc154b0f90a4b452c72fa433.r2.dev; font-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'

